# 环境配置
# 可选值: development, production
NODE_ENV=development

# 数据库配置
# 可选值: sqlite, mysql
DB_TYPE=sqlite

# SQLite配置（开发环境使用）
SQLITE_DB_PATH=./data/trae.db

# MySQL配置（生产环境使用）
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=trae

# 服务器配置
PORT=3002

# Swagger 配置
# 是否启用 Swagger API 文档
# 开发环境默认启用，生产环境默认禁用
ENABLE_SWAGGER=true
