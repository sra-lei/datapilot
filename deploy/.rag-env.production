# CharterMate 环境配置模板
# 复制为 .env 并填入真实值

# DeepSeek (Chat)
deepseek_api_key=sk-b7564789b4b34f479890532459093d96
deepseek_base_url=https://api.deepseek.com
llm_model=deepseek-chat

FALLBACK_API_KEY=sk-b7564789b4b34f479890532459093d96
FALLBACK_BASE_URL=https://api.deepseek.com
FALLBACK_MODEL=deepseek-chat

# 阿里百炼 (Embedding)
dashscope_api_key=sk-ws-H.REILMHE.2eLC.MEQCICl4EMDkBk1lqaJ9ZyVhtnZE3I5iFoF_p2UI25TTUB_OAiAUo4F-_BNTY51DpP5jbs5yRgZ8FsYGKd2sL1BKkXXzrg
dashscope_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
embedding_model=text-embedding-v2

# Redis 语义缓存
# Docker 容器内使用服务名 'redis'，本地开发使用 'localhost'
REDIS_URL=redis://redis:3379
SIMILARITY_THRESHOLD=0.92
CACHE_TTL_HOURS=24

# 混合检索（BM25 + 向量）
NEED_HYBRID_SEARCH=true

# 日志级别
log_level=INFO
