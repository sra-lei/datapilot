# ============================================================
# Datapolit 一键部署 - 环境变量模板
# 用法：复制为 .env 并填入真实值（deploy.sh 首次运行会自动复制）
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，严禁提交真实密钥
# ============================================================

# ============================================================
# Core 服务 + MySQL（core 容器与 mysql 容器共用本段）
# ============================================================
NODE_ENV=production
PORT=3002
ENABLE_SWAGGER=false

# 应用用户连接 MySQL 的配置（容器内通过服务名 mysql 访问）
DB_HOST=mysql
DB_PORT=3306
DB_USER=datapolit-core
DB_PASSWORD=change-me-db-password
DB_NAME=datapolit

# MySQL 初始化配置（仅 mysql 容器首次建库时生效）
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=datapolit
MYSQL_USER=datapolit-core
MYSQL_PASSWORD=change-me-db-password

# ============================================================
# RAG / CharterMate（datapolit-rag:8000）
# 注意：本服务读取小写变量名（deepseek_api_key 等）
# ============================================================
deepseek_api_key=change-me-deepseek-key
deepseek_base_url=https://api.deepseek.com
llm_model=deepseek-chat

FALLBACK_API_KEY=change-me-deepseek-key
FALLBACK_BASE_URL=https://api.deepseek.com
FALLBACK_MODEL=deepseek-chat

dashscope_api_key=change-me-dashscope-key
dashscope_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
embedding_model=text-embedding-v2

# Redis 语义缓存（容器内通过服务名 redis 访问，端口 6379）
REDIS_URL=redis://redis:6379
SIMILARITY_THRESHOLD=0.92
CACHE_TTL_HOURS=24

# 混合检索（BM25 + 向量）
NEED_HYBRID_SEARCH=true

log_level=INFO

# ============================================================
# Doc-Kit（datapolit-dockit:8100，文档处理）
# 本服务读取大写变量名（DASHSCOPE_API_KEY / DEEPSEEK_API_KEY / MILVUS_*）
# 注意：与上方 RAG 段的密钥保持一致
# ============================================================
DASHSCOPE_API_KEY=change-me-dashscope-key
DEEPSEEK_API_KEY=change-me-deepseek-key

# Zilliz Cloud（向量数据库，Serverless）
MILVUS_URI=change-me-milvus-uri
MILVUS_API_KEY=change-me-milvus-api-key

# ============================================================
# Docs-Seeker（datapolit-docs-seeker:8001，语义检索问答）
# 本服务读取大写变量名；MILVUS_TOKEN 与上方 MILVUS_API_KEY 对应
# ============================================================
DASHSCOPE_API_KEY=change-me-dashscope-key
DEEPSEEK_API_KEY=change-me-deepseek-key
MILVUS_URI=change-me-milvus-uri
MILVUS_TOKEN=change-me-milvus-api-key
SEMANTIC_CACHE_ENABLED=true
